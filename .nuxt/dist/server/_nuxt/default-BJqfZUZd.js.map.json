AA,IAAQ,aAAA;AAAA,QAA+B,OAAM;AAAA,QAAU,eAAY;AAAA,MAAA;;UAa1EA,MAAA,QAAA,GAAQ;;sBAOKA,MAAA,WAAA,EAAY,YAAU,CAA9B,SAAI;;YACV,KAAK,KAAK;AAAA,YACV,OAAO,KAAK;AAAA,YACZ,IAAI,KAAK;AAAA,YACT,wBAAU,SAAA,QAAQ;AAAA,UAAA;;;;UAEN,IAAG;AAAA,UAAY,MAAK;AAAA,UAAe,qBAAO,SAAA,QAAQ;AAAA,QAAA;2BAAjE,CAEgB,GAAAF,QAAAC,UAAA,aAAA;;;;;gCAF2D,iBAE3E;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;;;;;;;;AC1DH,YAAA,OAAAH,eAAAC,WAAA,EAAA,OAAM,oCAAgC,MAAA,CAAA,CAAA,GAAA;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_unref","_ssrInterpolate","_createTextVNode","_toDisplayString","$emit","_createVNode","_ssrRenderAttr"],"sources":["../../../../components/Organisms/FooterMain.vue","../../../../components/Molecules/NavLink.vue","../../../../components/Organisms/HeaderMain.vue","../../../../layouts/default.vue"],"sourcesContent":["<template>\n  <footer class=\"border-t border-ink/10 bg-linen/55\">\n    <div class=\"site-container grid gap-10 py-12 lg:grid-cols-[1.2fr_1fr_1fr]\">\n      <div>\n        <NuxtLink to=\"/\" class=\"font-serif text-3xl font-medium text-ink\">\n          {{ siteContent.brand.name }}\n        </NuxtLink>\n        <p class=\"mt-4 max-w-md leading-7 text-ink/68\">{{ siteContent.brand.payoff }}</p>\n        <p class=\"mt-6 text-sm text-ink/52\">{{ siteContent.brand.footerNote }}</p>\n      </div>\n\n      <nav aria-label=\"Navigazione secondaria\">\n        <p class=\"text-sm font-semibold uppercase tracking-[0.16em] text-clay\">Pagine</p>\n        <div class=\"mt-4 grid gap-3\">\n          <NuxtLink\n            v-for=\"item in siteContent.navigation\"\n            :key=\"item.to\"\n            :to=\"item.to\"\n            class=\"text-sm text-ink/68 transition hover:text-ink\"\n          >\n            {{ item.label }}\n          </NuxtLink>\n        </div>\n      </nav>\n\n      <div>\n        <p class=\"text-sm font-semibold uppercase tracking-[0.16em] text-clay\">Social</p>\n        <div class=\"mt-4 grid gap-3\">\n          <SocialLinkItem\n            v-for=\"social in siteContent.socials\"\n            :key=\"social.href\"\n            :href=\"social.href\"\n            :label=\"social.label\"\n            :handle=\"social.handle\"\n            :icon=\"social.icon\"\n          />\n        </div>\n      </div>\n    </div>\n    <div class=\"site-container border-t border-ink/10 py-5 text-sm text-ink/52\">\n      © {{ new Date().getFullYear() }} {{ siteContent.brand.name }}. Tutti i diritti riservati.\n    </div>\n  </footer>\n</template>\n\n<script setup lang=\"ts\">\nimport SocialLinkItem from '~/components/Molecules/SocialLinkItem.vue'\nimport { siteContent } from '~/data/siteContent'\n</script>\n","<template>\n  <NuxtLink\n    :to=\"to\"\n    class=\"rounded-full px-3 py-2 text-sm font-medium text-ink/72 transition hover:bg-white/60 hover:text-ink\"\n    :class=\"{ 'bg-white/70 text-ink shadow-line': isActive }\"\n    @click=\"$emit('navigate')\"\n  >\n    {{ label }}\n  </NuxtLink>\n</template>\n\n<script setup lang=\"ts\">\nconst props = defineProps<{\n  label: string\n  to: string\n}>()\n\ndefineEmits<{\n  navigate: []\n}>()\n\nconst route = useRoute()\nconst isActive = computed(() =>\n  props.to === '/' ? route.path === '/' : route.path.startsWith(props.to)\n)\n</script>\n","<template>\n  <header class=\"sticky top-0 z-50 border-b border-ink/10 bg-cream/88 backdrop-blur-xl\">\n    <div class=\"site-container flex min-h-20 items-center justify-between gap-4\">\n      <NuxtLink to=\"/\" class=\"group inline-flex items-center gap-3\" aria-label=\"Vai alla home\">\n        <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-line\">\n          <span class=\"h-4 w-4 rounded-full border-2 border-terracotta bg-sage/40 transition group-hover:scale-110\" />\n        </span>\n        <span class=\"font-serif text-2xl font-medium text-ink\">{{ siteContent.brand.name }}</span>\n      </NuxtLink>\n\n      <nav class=\"hidden items-center gap-1 lg:flex\" aria-label=\"Navigazione principale\">\n        <NavLink\n          v-for=\"item in siteContent.navigation\"\n          :key=\"item.to\"\n          :label=\"item.label\"\n          :to=\"item.to\"\n        />\n      </nav>\n\n      <div class=\"hidden lg:block\">\n        <ButtonPrimary to=\"/contatti\" icon=\"lucide:send\">Richiedi info</ButtonPrimary>\n      </div>\n\n      <button\n        type=\"button\"\n        class=\"inline-flex h-11 w-11 items-center justify-center rounded-full border border-ink/10 bg-white/70 text-ink shadow-line lg:hidden\"\n        :aria-expanded=\"menuOpen\"\n        aria-controls=\"mobile-menu\"\n        aria-label=\"Apri o chiudi il menu\"\n        @click=\"menuOpen = !menuOpen\"\n      >\n        <Icon :name=\"menuOpen ? 'lucide:x' : 'lucide:menu'\" class=\"h-5 w-5\" aria-hidden=\"true\" />\n      </button>\n    </div>\n\n    <Transition\n      enter-active-class=\"transition duration-200 ease-out\"\n      enter-from-class=\"-translate-y-2 opacity-0\"\n      enter-to-class=\"translate-y-0 opacity-100\"\n      leave-active-class=\"transition duration-150 ease-in\"\n      leave-from-class=\"translate-y-0 opacity-100\"\n      leave-to-class=\"-translate-y-2 opacity-0\"\n    >\n      <nav\n        v-if=\"menuOpen\"\n        id=\"mobile-menu\"\n        class=\"site-container pb-5 lg:hidden\"\n        aria-label=\"Navigazione mobile\"\n      >\n        <div class=\"grid gap-2 rounded-soft border border-ink/10 bg-white/70 p-3 shadow-soft\">\n          <NavLink\n            v-for=\"item in siteContent.navigation\"\n            :key=\"item.to\"\n            :label=\"item.label\"\n            :to=\"item.to\"\n            @navigate=\"menuOpen = false\"\n          />\n          <ButtonPrimary to=\"/contatti\" icon=\"lucide:send\" @click=\"menuOpen = false\">\n            Richiedi info\n          </ButtonPrimary>\n        </div>\n      </nav>\n    </Transition>\n  </header>\n</template>\n\n<script setup lang=\"ts\">\nimport ButtonPrimary from '~/components/Atoms/ButtonPrimary.vue'\nimport NavLink from '~/components/Molecules/NavLink.vue'\nimport { siteContent } from '~/data/siteContent'\n\nconst menuOpen = ref(false)\nconst route = useRoute()\n\nwatch(() => route.fullPath, () => {\n  menuOpen.value = false\n})\n</script>\n","<template>\n  <div class=\"min-h-screen bg-cream text-ink\">\n    <HeaderMain />\n    <main id=\"main-content\">\n      <slot />\n    </main>\n    <FooterMain />\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport FooterMain from '~/components/Organisms/FooterMain.vue'\nimport HeaderMain from '~/components/Organisms/HeaderMain.vue'\n</script>\n"],"version":3}